# ==============================================================================
# MEDHA Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit your actual .env file or real secrets to source control.
# In production, inject secrets via secure environment variables or secret manager.
# ==============================================================================

# --- Environment Profile ---
# Options: development, staging, production
ENVIRONMENT=development
# Set to false in production deployments
DEBUG=true

# --- Server Binding ---
HOST=0.0.0.0
PORT=8000

# --- Structured Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed origins.
# WARNING: Wildcard '*' is strictly prohibited in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000

# --- Database & Persistence Configuration (PostgreSQL / SQLAlchemy) ---
# Direct connection URL (takes precedence over POSTGRES_* individual fields if set).
# Production Requirement: Must use PostgreSQL. SQLite is strictly rejected in production.
# Examples:
#   PostgreSQL: postgresql+psycopg2://user:password@hostname:5432/medha_db
#   Development SQLite: sqlite:///./medha_dev.db (dev/test only)
DATABASE_URL=

# Individual PostgreSQL parameters (used if DATABASE_URL is not provided)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medha_db

# SQLAlchemy Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Authentication & JWT Security ---
# Production Requirement: Must be a cryptographically secure random string.
# Example generation: `openssl rand -hex 32`
# WARNING: The default development key is strictly rejected in production mode.
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min32chars
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Gemini LLM Configuration ---
# Production Requirement: GEMINI_API_KEY must be provided if Gemini features are enabled.
# Obtain a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Backward-compatible chatbot engine aliases
MEDHA_LLM_PROVIDER=gemini
MEDHA_LLM_MODEL=gemini-2.5-flash

# --- Storage Configuration ---
# Storage backend: currently 'local' (local filesystem upload directory)
STORAGE_BACKEND=local
# Directory where uploaded audio check-in files and attachments are placed
UPLOAD_DIR=uploads
# Maximum allowed audio upload size in bytes (default: 15 MB = 15728640 bytes)
MAX_AUDIO_SIZE_BYTES=15728640

# --- Behaviour Telemetry Analysis Configuration ---
BEHAVIOUR_LATE_NIGHT_START_HOUR=0
BEHAVIOUR_LATE_NIGHT_END_HOUR=6
BEHAVIOUR_LATE_NIGHT_TIMEZONE=UTC
